# Paycrest API Configuration
PAYCREST_API_KEY=your_paycrest_api_key_here
PAYCREST_WEBHOOK_SECRET=your_paycrest_webhook_secret_here

# Base Network Configuration (Server-side only - NEVER use NEXT_PUBLIC_)
BASE_PRIVATE_KEY=0xyour_base_private_key_here
BASE_RETURN_ADDRESS=0xyour_base_return_address_here
BASE_RPC_URL=https://mainnet.base.org

# New EVM source chains for offramp (multi-chain support). Each needs its
# own RPC endpoint — no public fallback, matching BASE_RPC_URL's existing
# strict requirement.
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
AVALANCHE_RPC_URL=
POLYGON_RPC_URL=
# Solana source chain (CCTP V2, domain 5). Server RPC — no public fallback
# (public devnet/mainnet endpoints rate-limit hard). Use a dedicated provider
# (Helius / QuickNode / Triton). Devnet vs mainnet follows CCTP_NETWORK.
SOLANA_RPC_URL=
# Comma-separated allowlist of which non-Stellar chains are selectable in the
# offramp dropdown, e.g. "arbitrum" then "arbitrum,base,solana". Empty/unset
# means none. NEXT_PUBLIC_ because the client dropdown reads it; the server
# routes read the same var to reject a disabled chain.
# The old name NEXT_PUBLIC_EVM_SOURCE_CHAINS_ENABLED is still read as a
# fallback for one release — update the deployment env, then drop it.
NEXT_PUBLIC_OFFRAMP_SOURCE_CHAINS_ENABLED=

# Allbridge Configuration (optional custom URLs)
# Legacy single var (supported): if horizon URL, it's mapped to STLR; otherwise SRB.
# STELLAR_RPC_URL=https://horizon.stellar.org
# Recommended explicit vars. Set STELLAR_SOROBAN_RPC_URL to a dedicated
# provider (Alchemy, Validation Cloud, QuickNode, ...) — the public gateway.fm
# endpoint is rate-limited and periodically slow, which has stranded offramp
# burns. Optional comma-separated backups in STELLAR_SOROBAN_RPC_URL_FALLBACK;
# calls fail over primary -> fallbacks -> public gateway.fm.
STELLAR_SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
# STELLAR_SOROBAN_RPC_URL_FALLBACK=https://second-provider.example/rpc,https://third.example/rpc
STELLAR_HORIZON_URL=https://horizon.stellar.org

# Allbridge Next (undocumented CCTP-routed API used for the Stellar<->Base
# offramp bridge, since Allbridge Core no longer supports this pair). Override
# only if Allbridge changes their endpoint.
# ALLBRIDGE_NEXT_API_URL=https://api.next.allbridge.io

# Public Configuration (safe to expose to client)
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
NEXT_PUBLIC_BASE_RETURN_ADDRESS=0xyour_base_return_address_here
# From dashboard.walletconnect.com (now also branded Reown).
# REQUIRED for mobile: phones have no browser extensions, so mobile wallets
# (Freighter, LOBSTR) are only reachable over WalletConnect.
# Also add every origin you serve from — production domain AND any tunnel used
# for mobile testing — to that project's allowed domains, or connecting fails
# with WebSocket close code 3000 "origin not allowed".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Platform Stats (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
# Hardcoded seed values shown before any real user activity
STATS_SEED_USERS=120
STATS_SEED_VOLUME=48000

# --- Onramp (fiat -> USDC on Stellar) ---
# Platform-operated custodial Base hot wallet. Paycrest delivers USDC here, the
# server bridges it to the user's Stellar wallet. Fund with ETH for Base gas.
ONRAMP_HOT_WALLET_ADDRESS=0xyour_base_hot_wallet_address
ONRAMP_HOT_WALLET_PRIVATE_KEY=0xyour_base_hot_wallet_private_key
# Refuse to bridge below this ETH balance (hold + alert instead). Optional.
ONRAMP_MIN_GAS_ETH=0.0005

# --- Telegram operational alerts (outbound-only) ---
# From @BotFather; chat/group id to receive alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram inbound webhook (/retry <orderId> command) ---
# Value passed as `secret_token` when registering setWebhook; Telegram echoes
# it back on every delivery so /api/webhooks/telegram can verify the sender.
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# --- Cron (onramp delivery finalizer) ---
# Protects /api/cron/finalize-onramp. Vercel Cron sends this as a Bearer token.
# Generate a random string; leave unset only for local dev.
CRON_SECRET=your_random_cron_secret_here

# --- Admin: manual onramp bridge retry ---
# Protects POST /api/admin/onramp/retry-bridge. Send as `Authorization: Bearer <this>`.
ADMIN_API_SECRET=your_random_admin_secret_here

# --- Settu API (auth + wallet linking) ---
# Base URL of the Rust backend. Must be an origin listed in that service's
# ALLOWED_ORIGINS, or every call fails CORS.
NEXT_PUBLIC_API_BASE_URL=https://settu-backend.onrender.com

# --- Agent Mode (natural-language offramp) ---
# Vercel AI Gateway — https://vercel.com/docs/ai-gateway. Two ways to auth,
# either is enough (the `ai` package checks AI_GATEWAY_API_KEY first, then
# falls back to VERCEL_OIDC_TOKEN automatically — no code change needed):
#   1. Recommended: `vercel link` then `vercel env pull .env.local` — this
#      provisions VERCEL_OIDC_TOKEN for you, no manual key. Re-run the pull
#      when it expires (~24h).
#   2. Manual static key — create one at vercel.com/<team>/<project>/settings
#      -> AI Gateway -> API Keys, and set it here:
AI_GATEWAY_API_KEY=your_ai_gateway_key_here
# Swappable without a code change. A small, fast model is enough for
# structured field extraction — no need for a frontier reasoning model here.
# Versioned slugs use dots, not hyphens (anthropic/claude-haiku-4.5, not
# claude-haiku-4-5) — confirm current slugs at vercel.com/docs/ai-gateway
# before changing this, model names on the gateway move fast.
AGENT_PARSE_MODEL=anthropic/claude-haiku-4.5
